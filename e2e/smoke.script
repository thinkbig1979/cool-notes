# End-to-end smoke test for cool-note. Run with e2e/run.sh.
# Colors are catppuccin-mocha: auto theme on the default black background.
wait-for Start typing
# 1-row, 2-column margin around the app; readable muted placeholder
assert-style text="Start typing." italic fg=#7f849c
assert-style 0,0,80 plain

# Typing, Tab indentation and auto-indent
type Groceries
key enter tab
type milk
key enter
type eggs
key enter shift+tab
type Done
assert Groceries ×
assert │   eggs
# Active tab uses the accent; indent guides are dim
assert-style text=" Groceries " bold bg=#cba6f7
assert-style 5,4 fg=#313244
capture first-note

# New tab via keyboard, then via mouse on the + button
key ctrl+t
wait-for Start typing
type Second
assert note 2/2
click 29,1
wait-for note 3/3
type Third
# Inactive tabs lose the accent
assert-style text=" Groceries " !bold bg=#313244
assert-style text=" Third " bold bg=#cba6f7
capture three-tabs

# Switch tabs by keyboard and by clicking a tab
key alt+left
assert note 2/3
click 5,1
assert note 1/3
assert Groceries
key ctrl+tab
assert note 2/3
key ctrl+shift+tab
assert note 1/3

# Delete with confirmation: cancel first, then confirm
key ctrl+w
wait-for Delete this note?
key esc
wait-gone Delete this note?
assert note 1/3
key alt+9
key ctrl+w
wait-for “Third” will be removed
# Delete is focused by default (danger color); arrows move focus to Cancel
assert-style text="Delete  " bg=#f38ba8
key right
assert-style text=Cancel bold bg=#cba6f7
assert-style text="Delete  " bg=#313244
key left
assert-style text="Delete  " bg=#f38ba8
key y
wait-for deleted “Third”
assert note 2/2
capture after-delete

# Help overlay
key f1
wait-for next / previous theme
key esc
wait-gone next / previous theme

# Mouse selection: double-click a word and replace it
click 5,1
dblclick 10,4
# The selected word is highlighted, the rest of the line is not
assert-style 9,4,4 bg=#45475a
assert-style 5,3,9 bg=default
type MILK
assert │   MILK

# Hotkey bar: shows the main keys, and clicking ^T adds a note
assert-style text=" ^T " bold bg=#313244
assert F1  help
click 4,21
wait-for note 3/3
key ctrl+w
wait-for Delete this note?
key y
wait-for note 2/2
click 5,1
assert │   MILK

# Resize reflows without losing content
resize 50x12
assert │   MILK
capture resized
